  purchaseOrders PurchaseOrder[]
}

model CateringEvent {
  id          String         @id @default(cuid())
  tenantId    String
  name        String
  date        DateTime
  guests      Int
  venue       String
  budget      Decimal        @db.Decimal(10, 2)
  status      CateringStatus
  contact     String
  phone       String
  menu        String
  notes       String
  depositPaid Boolean
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TakeawayOrder {
  id           String              @id @default(cuid())
  tenantId     String
  customerName String
  phone        String
  items        Json
  total        Decimal             @db.Decimal(10, 2)
  status       TakeawayOrderStatus
  pickupTime   String
  notes        String
  type         TakeawayOrderType
  address      String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ArchivedOrder {
  id            String                @id @default(cuid())
  tenantId      String
  sourceOrderId String?               @unique
  date          DateTime
  table         String
  waiter        String
  items         Json
  total         Decimal               @db.Decimal(10, 2)
  status        ArchivedOrderStatus
  paymentMethod ArchivedPaymentMethod
  closedAt      DateTime
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

