// ─── Multi-locale owner groups (100% additivo, non modifica nulla di esistente) ───

model TenantGroup {
  id        String               @id @default(cuid())
  name      String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   TenantGroupMember[]
}

model TenantGroupMember {
  id        String      @id @default(cuid())
  groupId   String
  tenantId  String
  label     String?
  addedAt   DateTime    @default(now())
  group     TenantGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, tenantId])
  @@index([tenantId])
}

model ChatMessage {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  userName   String
  userRole   String
  body       String
  replyToId  String?
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model StaffReward {
  id            String   @id @default(cuid())
  tenantId      String
  staffName     String
  type          String
  description   String
  value         Decimal? @db.Decimal(10, 2)
  period        String
  awardedBy     String
  awardedByName String
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, staffName, createdAt])
}
