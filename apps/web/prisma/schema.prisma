generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductPlan {
  restaurant_only
  hotel_only
  all_included
  risto_premium
  risto_premium_gold
  hotel_premium
  hotel_premium_gold
}

enum CustomerType {
  vip
  habitue
  walk_in
  new
}

enum LicenseStatus {
  trial
  active
  expired
  suspended
}

enum TenantAccessStatus {
  active
  blocked
}

enum StaffStatus {
  attivo
  ferie
  malattia
  licenziato
}

enum BookingStatus {
  confermata
  in_attesa
  annullata
  completata
}

enum CateringStatus {
  preventivo
  confermato
  completato
  annullato
}

enum TakeawayOrderStatus {
  nuovo
  in_preparazione
  pronto
  ritirato
  consegnato
  annullato
}

enum TakeawayOrderType {
  asporto
  delivery
}

enum ArchivedOrderStatus {
  completato
  annullato
  stornato
}

enum ArchivedPaymentMethod {
  contanti
  carta
  misto
}

enum RestaurantTableShape {
  tondo
  quadrato
}

enum RestaurantTableStatus {
  libero
  aperto
  conto
  sporco
}

enum TenantFeatureCode {
  restaurant
  hotel
  integration_room_charge
  integration_unified_folio
  integration_meal_plans
}

enum RestaurantOrderStatus {
  pending
  in_attesa
  in_preparazione
  pronto
  servito
  chiuso
  annullato
  conto_richiesto
}

enum RestaurantOrderOnlinePaymentStatus {
  unpaid
  paid
}

enum HotelReservationStatus {
  confermata
  in_casa
  check_out
  cancellata
  no_show
}

enum HotelRoomStatus {
  libera
  occupata
  da_pulire
  pulita
  fuori_servizio
  manutenzione
}

enum HousekeepingPmsCode {
  VC
  VD
  OC
  OD
  INSPECTED
  CLEAN
  DIRTY
  PICKUP
  TOUCHED
  OOO
  OOS
  MAINTENANCE
  BLOCKED
  VIP_READY
  DND
  LATE_CO
  EARLY_ARR
}

enum HousekeepingTaskType {
  departure
  stayover
  deep_clean
  turndown
  vip
  daily
  checkout
}

enum HousekeepingPriority {
  low
  normal
  high
  critical
  vip
}

enum MaintenanceTicketStatus {
  open
  assigned
  in_progress
  waiting_parts
  resolved
  closed
}

enum MaintenancePriority {
  low
  normal
  high
  urgent
}

enum BoardType {
  room_only
  bed_breakfast
  half_board
  full_board
}

enum FolioStatus {
  open
  closed
}

enum FolioAttachmentType {
  document
  passport
  contract
  signature
  voucher
  receipt
  photo
}

enum FolioChargeSource {
  hotel
  restaurant
  manual
  city_tax
  payment
  meal_plan_credit
  room_service
}

enum RoomServiceCategory {
  food
  laundry
  minibar
  shoe_cleaning
  linen
  amenities
  transport
  other
}

enum RoomServiceStatus {
  pending
  in_preparation
  out_for_delivery
  delivered
  cancelled
}

enum KeycardStatus {
  attiva
  scaduta
  annullata
}

enum GuestRegisterEntryStatus {
  draft
  incomplete
  complete
  checked_out
}

enum GuestRegisterTransmissionStatus {
  pending
  sent
  error
  cancelled
}

enum GuestRegisterPersonSex {
  M
  F
  X
  unknown
}

enum GuestRegisterDocumentType {
  passport
  identity_card
  driving_license
  visa
  other
}

enum GuestRegisterAttachmentType {
  document_front
  document_back
  passport
  visa
  driving_license
  receipt
  contract
  signature_privacy
  signature_checkin
  signature_rules
}

enum GuestRegisterOcrStatus {
  none
  pending
  completed
  verified
  failed
}

enum GuestRegisterCountry {
  IT
  NL
  BE
  DE
  FR
  ES
}

enum FolioBillingMode {
  guest
  company
  mixed
}

enum WarehouseMovementType {
  carico
  scarico
  scarico_comanda
  trasferimento
  rettifica
}

enum AiProposalType {
  food_cost
  warehouse
  menu
  pricing
  manager_report
  reorder
  hotel_bridge
}

enum AiProposalStatus {
  draft
  pending_review
  approved
  rejected
  applied
  cancelled
}

enum RestaurantOrderArea {
  sala
  cucina
  bar
  pizzeria
}

model Tenant {
  id           String              @id @default(cuid())
  name         String
  slug         String              @unique
  plan         ProductPlan
  accessStatus TenantAccessStatus  @default(active)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  features    TenantFeature[]
  users       User[]
  customers   Customer[]
  license    TenantLicense?
  emailConfig TenantEmailConfig?
  hotelRatePlans HotelRatePlan[]
  hotelRooms  HotelRoom[]
  reservations HotelReservation[]
  stays       Stay[]
  folios      GuestFolio[]
  folioAuditLogs FolioAuditLog[]
  folioAttachments FolioAttachment[]
  guestRegisterEntries GuestRegisterEntry[]
  guestRegisterPersons GuestRegisterPerson[]
  guestRegisterAttachments GuestRegisterAttachment[]
  guestRegisterTransmissions GuestRegisterTransmission[]
  guestRegisterAuditLogs GuestRegisterAuditLog[]
  guestRegisterAccessLogs GuestRegisterAccessLog[]
  folioCompanyAccounts FolioCompanyAccount[]
  folioMergeLogs FolioMergeLog[]
  folioEmailLogs FolioEmailLog[]
  housekeepingTasks HousekeepingTask[]
  housekeepingChecklistTemplates HousekeepingChecklistTemplate[]
  housekeepingInspections HousekeepingInspection[]
  maintenanceTickets MaintenanceTicket[]
  housekeepingAuditLogs HousekeepingAuditLog[]
  keycards    HotelKeycard[]
  warehouseItems WarehouseItem[]
  warehouseMovements WarehouseMovement[]
  warehouseEquipments WarehouseEquipment[]
  warehouseLots WarehouseLot[]
  warehouseCostHistory WarehouseCostHistory[]
  warehouseLocationStocks WarehouseLocationStock[]
  operationalNotes OperationalNote[]
  shiftPlans ShiftPlan[]
  aiChatLogs  AiChatLog[]
  aiUserMemoryProfiles AiUserMemoryProfile[]
  aiMemoryTurns AiMemoryTurn[]
  aiMemoryVectors AiMemoryVector[]
  aiProposals AiProposal[]
  aiLearningFeedback AiLearningFeedback[]
  aiLearningPatterns AiLearningPattern[]
  aiAutomationConfigs AiAutomationConfig[]
  aiAutomationRuns AiAutomationRun[]
  aiAutomationAuditLogs AiAutomationAuditLog[]
  recipes     Recipe[]
  menuItems   MenuItem[]
  dailyDishes DailyDish[]
  restaurantOrders RestaurantOrder[]
  dailyClosureReports DailyClosureReport[]
  staffMembers StaffMember[]
  bookings Booking[]
  suppliers Supplier[]
  cateringEvents CateringEvent[]
  takeawayOrders TakeawayOrder[]
  archivedOrders ArchivedOrder[]
  restaurantRooms RestaurantRoom[]
  restaurantTables RestaurantTable[]
  staffShifts StaffShift[]
  billingSubscriptions BillingSubscription[]
  billingEvents BillingEvent[]
  purchaseOrders PurchaseOrder[]
  purchaseOrderItems PurchaseOrderItem[]
  archivedSupplierOrders ArchivedSupplierOrder[]
  haccpEntries HaccpEntry[]
  hardwareDevices HardwareDevice[]
  printRoutes PrintRoute[]
  supervisorStorni SupervisorStorno[]
  warehouseVoiceLogs WarehouseVoiceLog[]
  archivioFiscalStubs      ArchivioFiscalStub[]
  notifications            Notification[]
  roomServiceOrders        RoomServiceOrder[]
  roomServiceCatalogItems  RoomServiceCatalogItem[]
  emailTemplates           EmailTemplate[]
  emailLogs                EmailLog[]
  wineCellarItems          WineCellarItem[]
  chatMessages             ChatMessage[]
  staffRewards             StaffReward[]
}

model BillingSubscription {
  id                   String   @id @default(cuid())
  tenantId             String
  stripeCustomerId     String?
  stripeSubscriptionId String   @unique
  priceId              String?
  status               String
  cancelAtPeriodEnd    Boolean  @default(false)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model BillingEvent {
  id            String   @id @default(cuid())
  tenantId      String?
  stripeEventId String   @unique
  type          String
  status        String
  payload       Json
  createdAt     DateTime @default(now())
  processedAt   DateTime?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, type])
  @@index([createdAt])
}

model PlatformConfig {
  id               String   @id
  maintenanceMode  Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String
  actorRole  String
  actorEmail String?
  action     String
  tenantId   String?
  targetId   String?
  metadata   Json?
  ipAddress  String?

  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@index([action, createdAt])
}

model RateLimitHit {
  id        BigInt   @id @default(autoincrement())
  bucket    String
  keyHash   String
  createdAt DateTime @default(now())

  @@index([bucket, keyHash, createdAt])
  @@index([createdAt])
}

model TenantFeature {
  id       String            @id @default(cuid())
  tenantId String
  code     TenantFeatureCode
  enabled  Boolean           @default(true)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  username     String   @unique
  passwordHash String
  name         String
  email        String   @unique
  role         String
  partnerCode  String?
  sessionVersion Int @default(0)
  mustChangePassword Boolean @default(false)
  failedLoginAttempts Int @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions     UserSession[]
}

model UserSession {
  id         String    @id @default(cuid())
  userId     String
  tenantId   String?
  jti        String    @unique
  tokenType  String    @default("access")
  userAgent  String?
  ipAddress  String?
  issuedAt   DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  revokedBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([tenantId, revokedAt])
  @@index([expiresAt])
}

model Customer {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  email       String?
  phone       String?
  type        CustomerType @default(new)
  visits      Int @default(0)
  totalSpent  Decimal @db.Decimal(10, 2) @default(0)
  avgSpend    Decimal @db.Decimal(10, 2) @default(0)
  lastVisit   DateTime?
  allergies   String?
  preferences String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations HotelReservation[]
  folios      GuestFolio[]

  @@index([tenantId])
  @@index([tenantId, email])
}

model TenantLicense {
  id           String        @id @default(cuid())
  tenantId     String        @unique
  licenseKey   String        @unique
  status       LicenseStatus @default(active)
  plan         ProductPlan
  billingCycle String
  seats        Int
  usedSeats    Int
  activatedAt  DateTime
  expiresAt    DateTime
  partnerCode  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner      Partner?      @relation(fields: [partnerCode], references: [code])
}

model Partner {
  id                      String          @id @default(cuid())
  code                    String          @unique
  name                    String
  country                 String
  email                   String          @default("")
  phone                   String          @default("")
  notes                   String          @default("")
  commissionType          String          @default("fixed")
  licensePrice            Float
  commissionEuros         Float
  commissionPct           Float           @default(0)
  allInclusivePrice       Float?
  allInclusiveCommission  Float?
  allInclusivePct         Float?
  active                  Boolean         @default(true)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  licenses                TenantLicense[]
}

model TenantEmailConfig {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  host           String
  port           Int
  username       String
  password       String
  fromAddress    String
  secure         Boolean  @default(false)
  lastTestStatus String?
  lastTestedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model HotelRoom {
  id                  String          @id @default(cuid())
  tenantId            String
  code                 String
  floor                Int
  roomType             String
  capacity             Int
  status               HotelRoomStatus
  ratePlanCode         String?
  /// Tariffa pubblicabile per notte (listino camera); usata in prenotazioni / booking interno.
  defaultNightlyRate   Decimal         @db.Decimal(10, 2) @default(0)
  hkPmsCode            HousekeepingPmsCode?
  doNotDisturb         Boolean         @default(false)
  vipReady             Boolean         @default(false)
  isBlocked            Boolean         @default(false)
  hkPriority           Int             @default(0)
  estimatedCleanMin    Int             @default(30)
  hkNotes              String?
  updatedAt            DateTime        @updatedAt @default(now())
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations HotelReservation[]
  tasks        HousekeepingTask[]
  keycards     HotelKeycard[]
  guestRegisterEntries GuestRegisterEntry[]
  maintenanceTickets MaintenanceTicket[]
  housekeepingInspections HousekeepingInspection[]

  @@unique([tenantId, code])
}

model HotelRatePlan {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  roomType    String
  boardType   BoardType
  nightlyRate Decimal  @db.Decimal(10, 2)
  refundable  Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, roomType, active])
}

model HotelReservation {
  id           String                @id @default(cuid())
  tenantId     String
  customerId   String
  roomId       String?
  guestName    String
  phone        String?
  email        String?
  checkInDate  DateTime
  checkOutDate DateTime
  guests       Int
  status       HotelReservationStatus
  roomType     String
  boardType    BoardType
  nights       Int
  rate         Decimal               @db.Decimal(10, 2)
  documentCode String?
  nationality  String?
  address      String?
  company      String?
  channel      String?               @default("direct")
  children     Int                   @default(0)
  crib         Boolean               @default(false)
  lateCheckout Boolean               @default(false)
  earlyCheckin Boolean               @default(false)
  depositReceived Decimal?           @db.Decimal(10, 2)
  receptionNotes String?
  packageName  String?
  ratePlanName String?
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  room         HotelRoom?            @relation(fields: [roomId], references: [id], onDelete: SetNull)
  stay         Stay?
  keycards     HotelKeycard[]
  guestRegisterEntry GuestRegisterEntry?

  @@index([tenantId, checkInDate])
  @@index([tenantId, status])
}

model Stay {
  id               String             @id @default(cuid())
  tenantId         String
  reservationId    String             @unique
  actualCheckInAt  DateTime?
  actualCheckOutAt DateTime?
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservation      HotelReservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  folio            GuestFolio?
  guestRegisterEntry GuestRegisterEntry?
}

model HousekeepingTask {
  id               String               @id @default(cuid())
  tenantId         String
  roomId           String
  assignedToUserId String?
  status           String
  scheduledFor     DateTime
  taskType         HousekeepingTaskType @default(departure)
  priority         HousekeepingPriority @default(normal)
  estimatedMin     Int                  @default(30)
  actualMin        Int?
  notes            String?
  voiceNoteUrl     String?
  signatureData    String?
  photosJson       String?
  checklistJson    String?
  guestName        String?
  arrivalDate      DateTime?
  departureDate    DateTime?
  inspectionLevel  Int                  @default(0)
  inspectedAt      DateTime?
  inspectedByUserId String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room             HotelRoom            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  inspections      HousekeepingInspection[]

  @@index([tenantId, status])
  @@index([tenantId, scheduledFor])
  @@index([roomId, scheduledFor])
}

model HousekeepingChecklistTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  roomType    String
  taskType    HousekeepingTaskType
  itemsJson   String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, roomType, taskType])
}

model HousekeepingInspection {
  id              String   @id @default(cuid())
  tenantId        String
  taskId          String
  roomId          String
  level           Int
  approved        Boolean  @default(false)
  supervisorId    String?
  signatureData   String?
  photosJson      String?
  comments        String?
  createdAt       DateTime @default(now())
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task            HousekeepingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  room            HotelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([tenantId, roomId])
  @@index([taskId, level])
}

model MaintenanceTicket {
  id              String                  @id @default(cuid())
  tenantId        String
  roomId          String
  title           String
  description     String
  status          MaintenanceTicketStatus @default(open)
  priority        MaintenancePriority     @default(normal)
  assignedToUserId String?
  materials       String?
  cost            Decimal?                @db.Decimal(10, 2)
  estimatedMin    Int?
  actualMin       Int?
  photosJson      String?
  resolvedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room            HotelRoom               @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([roomId])
}

model HousekeepingAuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  roomId    String?
  taskId    String?
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  userId    String?
  userName  String?
  userRole  String?
  ip        String?
  userAgent String?
  device    String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([roomId])
}

model GuestFolio {
  id         String       @id @default(cuid())
  tenantId   String
  customerId String
  stayId     String?      @unique
  currency   String       @default("EUR")
  balance    Decimal      @db.Decimal(10, 2)
  status     FolioStatus  @default(open)
  locked     Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  stay       Stay?        @relation(fields: [stayId], references: [id], onDelete: SetNull)
  charges    FolioCharge[]
  auditLogs  FolioAuditLog[]
  attachments FolioAttachment[]
  companyAssignments FolioCompanyAssignment[]
  splitDefinitions FolioSplitDefinition[]
  emailLogs FolioEmailLog[]
}

model FolioCharge {
  id              String            @id @default(cuid())
  folioId         String
  source          FolioChargeSource
  sourceId        String?
  description     String
  amount          Decimal           @db.Decimal(10, 2)
  postedAt        DateTime          @default(now())
  department      String?
  operator        String?
  quantity        Decimal           @default(1) @db.Decimal(10, 3)
  unitPrice       Decimal?          @db.Decimal(10, 2)
  vatPct          Decimal           @default(10) @db.Decimal(5, 2)
  section         String?
  splitCode       String            @default("A")
  lineStatus      String            @default("posted")
  createdByUserId String?
  createdByName   String?
  folio           GuestFolio        @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([folioId, postedAt])
  @@index([folioId, splitCode])
  @@index([folioId, sourceId])
}

model FolioAuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  folioId   String
  chargeId  String?
  userId    String?
  userName  String?
  userRole  String?
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  ip        String?
  userAgent String?
  device    String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folio     GuestFolio @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([tenantId, folioId, createdAt])
}

model FolioAttachment {
  id               String              @id @default(cuid())
  tenantId         String
  folioId          String
  type             FolioAttachmentType
  fileName         String
  mimeType         String
  fileSize         Int
  dataBase64       String              @db.Text
  uploadedByUserId String?
  uploadedByName   String?
  createdAt        DateTime            @default(now())
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folio            GuestFolio          @relation(fields: [folioId], references: [id], onDelete: Cascade)

  @@index([tenantId, folioId])
}

model GuestRegisterEntry {
  id                  String                          @id @default(cuid())
  tenantId            String
  reservationId       String                          @unique
  stayId              String?                         @unique
  roomId              String?
  status              GuestRegisterEntryStatus        @default(draft)
  transmissionStatus  GuestRegisterTransmissionStatus @default(pending)
  transmissionCountry GuestRegisterCountry            @default(IT)
  arrivalDate         DateTime
  departureDate       DateTime
  guestCount          Int                             @default(1)
  adults              Int                             @default(1)
  children            Int                             @default(0)
  roomCode            String?
  notes               String?
  lastTransmissionAt  DateTime?
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
  tenant              Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservation         HotelReservation                @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  stay                Stay?                           @relation(fields: [stayId], references: [id], onDelete: SetNull)
  room                HotelRoom?                      @relation(fields: [roomId], references: [id], onDelete: SetNull)
  persons             GuestRegisterPerson[]
  attachments         GuestRegisterAttachment[]
  transmissions       GuestRegisterTransmission[]
  auditLogs           GuestRegisterAuditLog[]

  @@index([tenantId, arrivalDate])
  @@index([tenantId, departureDate])
  @@index([tenantId, status])
  @@index([tenantId, transmissionStatus])
  @@index([tenantId, roomCode])
}

model GuestRegisterPerson {
  id                       String                     @id @default(cuid())
  tenantId                 String
