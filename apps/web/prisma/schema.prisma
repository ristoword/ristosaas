  tenantId   String
  name       String
  category   RoomServiceCategory
  unitPrice  Decimal             @db.Decimal(10, 2)
  unit       String              @default("pz")
  active     Boolean             @default(true)
  sortOrder  Int                 @default(0)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, category])
  @@index([tenantId, active])
}

/// Ordine di servizio in camera: food, lavanderia, minibar, pulizia scarpe, ecc.
model RoomServiceOrder {
  id             String              @id @default(cuid())
  tenantId       String
  stayId         String?
  folioId        String?
  roomCode       String
  guestName      String
  category       RoomServiceCategory
  status         RoomServiceStatus   @default(pending)
  items          Json
  total          Decimal             @db.Decimal(10, 2)
  notes          String              @default("")
  assignedTo     String?
  requestedAt    DateTime            @default(now())
  deliveredAt    DateTime?
  chargedToFolio Boolean             @default(false)
  folioChargeId  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, requestedAt])
  @@index([tenantId, roomCode])
  @@index([tenantId, assignedTo, status])
}

