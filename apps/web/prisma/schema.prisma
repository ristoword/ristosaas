model RestaurantRoom {
  id        String            @id @default(cuid())
  tenantId  String
  name      String
  tables    Int
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roomTables RestaurantTable[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model RestaurantTable {
  id        String               @id @default(cuid())
  tenantId  String
  roomId    String
  nome      String
  posti     Int
  x         Int
  y         Int
  forma     RestaurantTableShape
  stato     RestaurantTableStatus
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room      RestaurantRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([tenantId, roomId])
}

enum PurchaseOrderStatus {
  bozza
  inviato
  parziale
  ricevuto
  annullato
}

/// Registro archivio documenti ordine fornitore (conferma bozza vs ordine emesso).
enum ArchivedSupplierOrderKind {
  bozza_confermata
  ordine_confermato
}

model PurchaseOrder {
  id              String               @id @default(cuid())
  tenantId        String
  supplierId      String
  code            String
  status          PurchaseOrderStatus  @default(bozza)
  notes           String               @default("")
  orderedAt       DateTime             @default(now())
  expectedAt      DateTime?
  receivedAt      DateTime?
  total           Decimal              @db.Decimal(12, 2) @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier        Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items           PurchaseOrderItem[]
  archivedSupplierOrder ArchivedSupplierOrder?

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
}

model ArchivedSupplierOrder {
  id               String                     @id @default(cuid())
  tenantId         String
  purchaseOrderId  String                     @unique
  code             String
  supplierId       String
  supplierName     String
  poStatus         PurchaseOrderStatus
  kind             ArchivedSupplierOrderKind
  total            Decimal                    @db.Decimal(12, 2)
  orderedAt        DateTime?
  notes            String                     @default("")
  archivedAt       DateTime                   @default(now())
  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder    PurchaseOrder              @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId, archivedAt])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  tenantId        String
  purchaseOrderId String
  warehouseItemId String
  qtyOrdered      Decimal       @db.Decimal(12, 3)
  qtyReceived     Decimal       @db.Decimal(12, 3) @default(0)
  unit            String
  unitCost        Decimal       @db.Decimal(12, 4)
  notes           String        @default("")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order           PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  warehouseItem   WarehouseItem @relation(fields: [warehouseItemId], references: [id], onDelete: Restrict)

  @@index([tenantId, purchaseOrderId])
  @@index([tenantId, warehouseItemId])
}

enum HaccpEntryType {
  temp_frigo
  temp_freezer
  temp_cottura
  temp_abbattitore
  sanificazione
  ricezione_merce
  pulizia_manutenzione
  disinfestazione
  non_conformita
  formazione_personale
  olio_frittura
  allergeni
  acqua_potabile
  rifiuti
  altro
}

model HaccpEntry {
  id               String          @id @default(cuid())
  tenantId         String
  type             HaccpEntryType  @default(temp_frigo)
  recordedAt       DateTime        @default(now())
  location         String          @default("")
  tempC            Decimal?        @db.Decimal(5, 2)
  thresholdMin     Decimal?        @db.Decimal(5, 2)
  thresholdMax     Decimal?        @db.Decimal(5, 2)
  conforme         Boolean?
  correctiveAction String          @default("")
  operator         String          @default("")
  notes            String          @default("")
  supplier         String          @default("")
  product          String          @default("")
  lotNumber        String          @default("")
  expiryDate       DateTime?
  cleaningProduct  String          @default("")
  dilution         String          @default("")
  contactTime      String          @default("")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, recordedAt])
  @@index([tenantId, type, recordedAt])
}

enum HardwareDeviceType {
  stampante_termica
  stampante_fiscale
  display_kds
  lettore_keycard
  cassetto_denaro
  altro
}

enum HardwareDeviceConnection {
  tcp_ip
  usb
  bluetooth
  hdmi
  altro
}

enum HardwareDeviceStatus {
  online
  offline
  manutenzione
}

enum HardwareDepartment {
  cucina
  pizzeria
  bar
  cassa
  sala
  reception
  housekeeping
  magazzino
  altro
}

model HardwareDevice {
  id         String                    @id @default(cuid())
  tenantId   String
  name       String
  type       HardwareDeviceType        @default(stampante_termica)
  department HardwareDepartment        @default(cucina)
  connection HardwareDeviceConnection  @default(tcp_ip)
  ipAddress  String?
  port       Int?
  status     HardwareDeviceStatus      @default(offline)
  notes      String                    @default("")
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  tenant     Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  routes     PrintRoute[]              @relation("DeviceRoutes")

  @@unique([tenantId, name])
  @@index([tenantId, department])
  @@index([tenantId, status])
}

enum PrintRouteEvent {
  nuova_comanda
  ordine_bevande
  chiusura_conto
  preconto
  nota_cucina
  keycard_emessa
}

model PrintRoute {
  id         String             @id @default(cuid())
  tenantId   String
  event      PrintRouteEvent
  department HardwareDepartment
  deviceId   String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device     HardwareDevice     @relation("DeviceRoutes", fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, event, department])
  @@index([tenantId, department])
  @@index([tenantId, deviceId])
}

/// Registro storni / aggiustamenti incasso lato supervisor (non sostituisce documentazione fiscale).
model SupervisorStorno {
  id        String   @id @default(cuid())
  tenantId  String
  amount    Decimal  @db.Decimal(12, 2)
  motivo    String
  tavolo    String   @default("")
  ordineId  String   @default("")
  note      String   @default("")
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

/// Traccia comandi vocali magazzino (testo grezzo) per audit interno.
model WarehouseVoiceLog {
  id          String   @id @default(cuid())
  tenantId    String
  transcript  String
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

/// Schede fiscali interne (entrata/cassa) finché non c’è integrazione RT — registro amministrativo per tenant.
model ArchivioFiscalStub {
  id           String   @id @default(cuid())
  tenantId     String
  kind         String
  reference    String   @default("")
  counterparty String   @default("")
  issueDate    DateTime @default(now())
  amount       Decimal  @db.Decimal(12, 2) @default(0)
  vatRateNote  String   @default("")
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, kind, createdAt])
}

/// Log degli invii email del tenant (SMTP transazionale).
model EmailLog {
  id          String   @id @default(cuid())
  tenantId    String
  toEmail     String
  subject     String
  templateSlug String  @default("")
  status      String   @default("sent")
  errorMessage String  @default("")
  sentAt      DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, sentAt])
  @@index([tenantId, templateSlug])
}

/// Template email personalizzabili per il tenant (conferme, notifiche, ecc.).
model EmailTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  slug      String
  subject   String
  body      String   @db.Text
  variables String   @default("")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@index([tenantId])
}

/// Notifiche in-app per gli utenti del tenant.
model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  type      String   @default("sistema")
  title     String
  message   String   @default("")
  href      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, read, createdAt])
  @@index([tenantId, createdAt])
}

/// Catalogo voci del servizio in camera (configurabile dall'hotel manager).
model RoomServiceCatalogItem {
