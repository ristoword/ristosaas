# ============================================================
# RistoSimply — Variabili d'ambiente usate dall'app
# Copia in .env.local e compila i valori
# ============================================================

# ---------- App / Tenant ----------
NEXT_PUBLIC_APP_URL=https://ristosimply.com
# URL canonico del sito marketing (metadataBase, sitemap, robots). Opzionale se coincide con APP_URL.
NEXT_PUBLIC_SITE_URL=https://ristosimply.com
NEXT_PUBLIC_APP_VERSION=1.0.0
APP_VERSION=1.0.0
# Opzionale: URL (es. chat esterna) per il pulsante "AI Assistant" nel Super Admin
NEXT_PUBLIC_SUPERADMIN_ASSISTANT_URL=

# Fallback cosmetici (plan reale arriva dal server via /api/auth/me)
NEXT_PUBLIC_PRODUCT_PLAN=all_included
NEXT_PUBLIC_TENANT_NAME="RistoSimply Demo"

# Landing: opzionale, path a uno screenshot reale della dashboard
# Esempio: /landing/dashboard-hero.png (file in apps/web/public/landing/)
NEXT_PUBLIC_LANDING_DASHBOARD_IMAGE=

# ---------- Database / PostgreSQL ----------
# Usa password URL-encoded (es. @ -> %40, : -> %3A, / -> %2F)
DATABASE_URL=postgresql://postgres:replace_with_url_encoded_password@db-host:5432/railway?sslmode=require

# ---------- Auth / JWT ----------
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
SESSION_MAX_AGE_SECONDS=86400
SESSION_MAX_AGE_SUPERVISOR_SECONDS=43200
SESSION_MAX_AGE_SUPERADMIN_SECONDS=28800
REFRESH_MAX_AGE_SECONDS=1209600
SEED_SUPERADMIN_PASSWORD=change-me-strong-password

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_test_...
# Opzionale: mostrata in maschera nella pagina /stripe (mai la secret)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_RESTAURANT_MONTHLY=price_restaurant_monthly_id
STRIPE_PRICE_RESTAURANT_ANNUAL=price_restaurant_annual_id
STRIPE_PRICE_HOTEL_MONTHLY=price_hotel_monthly_id
STRIPE_PRICE_HOTEL_ANNUAL=price_hotel_annual_id
STRIPE_PRICE_ALL_INCLUDED_MONTHLY=price_all_included_monthly_id
STRIPE_PRICE_ALL_INCLUDED_ANNUAL=price_all_included_annual_id
STRIPE_SEATS_RESTAURANT=15
STRIPE_SEATS_HOTEL=15
STRIPE_SEATS_ALL_INCLUDED=25
# Premium plans (from pricing page)
STRIPE_PRICE_RISTO_PREMIUM_MONTHLY=price_1TlW9MDLf6L68ZWUwGqX2a6D
STRIPE_PRICE_RISTO_PREMIUM_GOLD_MONTHLY=price_1TlWDLDLf6L68ZWUE26iyD9G
STRIPE_PRICE_HOTEL_PREMIUM_MONTHLY=price_1TlWBLDLf6L68ZWUMUWDaGU9
STRIPE_PRICE_HOTEL_PREMIUM_GOLD_MONTHLY=price_1TlWFFDLf6L68ZWU1eyHpWBM
STRIPE_SEATS_RISTO_PREMIUM=5
STRIPE_SEATS_RISTO_PREMIUM_GOLD=999
STRIPE_SEATS_HOTEL_PREMIUM=5
STRIPE_SEATS_HOTEL_PREMIUM_GOLD=999
STRIPE_PORTAL_RETURN_URL=https://your-app-domain.com/stripe
STRIPE_CHECKOUT_SUCCESS_URL=https://your-app-domain.com/stripe?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=https://your-app-domain.com/stripe?checkout=cancel

# ---------- Observability ----------
LOG_LEVEL=info
SENTRY_ENABLED=false
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_COOLDOWN_SECONDS=300

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.7
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# RAG + pgvector: semantic retrieval from manuale utente (PostgreSQL extension "vector")
RAG_TOP_K=4
RAG_MIN_SCORE=0.32

# ---------- AI Scheduler ----------
AI_SCHEDULER_TOKEN=replace-with-a-strong-random-token
