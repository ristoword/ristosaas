# ============================================================
# RistoSimply — Root env reference
# Copia questo file in `.env` nella root del monorepo e compila i valori.
# I valori applicativi completi stanno in `apps/web/.env.example`.
# MAI committare il file .env reale — è in .gitignore.
# ============================================================

# ---------- Database / PostgreSQL ----------
# Usa password URL-encoded (es. @ -> %40, : -> %3A, / -> %2F)
DATABASE_URL=postgresql://postgres:change-me@db-host:5432/railway?sslmode=require

# ---------- Auth / JWT ----------
# Genera con: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
SESSION_MAX_AGE_SECONDS=86400
SESSION_MAX_AGE_SUPERVISOR_SECONDS=43200
SESSION_MAX_AGE_SUPERADMIN_SECONDS=28800
REFRESH_MAX_AGE_SECONDS=1209600
SEED_SUPERADMIN_PASSWORD=change-me-strong-password

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_PRICE_RESTAURANT_MONTHLY=price_...
STRIPE_PRICE_RESTAURANT_ANNUAL=price_...
STRIPE_PRICE_HOTEL_MONTHLY=price_...
STRIPE_PRICE_HOTEL_ANNUAL=price_...
STRIPE_PRICE_ALL_INCLUDED_MONTHLY=price_...
STRIPE_PRICE_ALL_INCLUDED_ANNUAL=price_...
STRIPE_SEATS_RESTAURANT=15
STRIPE_SEATS_HOTEL=15
STRIPE_SEATS_ALL_INCLUDED=25
STRIPE_PORTAL_RETURN_URL=https://your-app-domain.com/stripe
STRIPE_CHECKOUT_SUCCESS_URL=https://your-app-domain.com/stripe?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=https://your-app-domain.com/stripe?checkout=cancel

# ---------- App / Tenant ----------
NEXT_PUBLIC_APP_URL=https://your-app-domain.com
NEXT_PUBLIC_SITE_URL=https://your-app-domain.com
NEXT_PUBLIC_APP_VERSION=1.0.0
APP_VERSION=1.0.0
NEXT_PUBLIC_PRODUCT_PLAN=all_included
NEXT_PUBLIC_TENANT_ID=tenant_demo
NEXT_PUBLIC_TENANT_NAME="RistoSimply Demo"
TENANT_ID=

# ---------- Observability ----------
LOG_LEVEL=info
SENTRY_ENABLED=false
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_COOLDOWN_SECONDS=300

# ---------- OpenAI ----------
# NOTA: variabile con underscore, non trattino
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.7

# ---------- AI Scheduler ----------
# Genera con: openssl rand -hex 32
AI_SCHEDULER_TOKEN=change-me-openssl-rand-hex-32
